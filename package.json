{
  "name": "@ephemushroom/opencode-claude-mem",
  "version": "0.4.4",
  "description": "OpenCode plugin for Claude-Mem persistent memory system",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --format esm && bun build src/v2.ts --outfile dist/v2.js --target bun --format esm && bun build src/tui.ts --outfile dist/tui.js --target bun --format esm --external @opentui/solid --external solid-js && bun build src/cli.ts --outfile dist/cli.js --target bun --format esm --external @opentui/solid --external solid-js && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "oxlint",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "keywords": [
    "opencode",
    "claude-mem",
    "memory",
    "plugin",
    "persistent-memory"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemushroom/opencode-claude-mem.git"
  },
  "bugs": {
    "url": "https://github.com/Ephemushroom/opencode-claude-mem/issues"
  },
  "homepage": "https://github.com/Ephemushroom/opencode-claude-mem#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentui/solid": "0.5.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.41",
    "@opencode-ai/plugin-v2": "npm:@opencode-ai/plugin@next",
    "@opencode-ai/theme": "^0.0.0-next-17030",
    "@opentui/core": "0.5.1",
    "@opentui/solid": "0.5.1",
    "@types/bun": "latest",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.63.0",
    "solid-js": "1.9.14",
    "typescript": "^5.9.3"
  }
}
